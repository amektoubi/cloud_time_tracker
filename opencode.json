{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./.opencode/rules/security.md",
    "./.opencode/skills/**/*.md",
    "./documentation/docs/specs/*.md",
    "./documentation/docs/docs/*.md"
  ],
  "agent": {
    "java-architect": {
      "path": "./.opencode/agents/java_architect.md"
    },
    "react-expert": {
      "path": "./.opencode/agents/react_expert.md"
    },
    "devops-engineer": {
      "path": "./.opencode/agents/devops.md"
    },
    "automation-scripter": {
      "path": "./.opencode/agents/scripter.md"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "YOUR_API_KEY"
      ],
      "enabled": true
    }
  }
}
